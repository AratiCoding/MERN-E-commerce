# --- 1. Dependencies (Essential) ---
# Automatically ignores node_modules in any folder (root, backend, or frontend)
node_modules/
jspm_packages/
.pnp.*
.yarn/*

# --- 2. Environment & Secrets (Security Critical) ---
# Prevents leaking API keys and database passwords
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
# If using Firebase or similar services
.firebase/
serviceAccountKey.json

# --- 3. Build & Distribution (Automated Outputs) ---
# Frontend build folders (React, Next.js, Vue, etc.)
frontend/dist/
frontend/build/
frontend/.next/
frontend/.nuxt/
# Backend build folders
backend/dist/
backend/build/
backend/out/

# --- 4. Logs & Debugging ---
# Local error logs that shouldn't be shared
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pids
*.pid
*.seed
*.pid.lock

# --- 5. Operating System & Editor Files (The "I didn't know" list) ---
# macOS system files (very common)
.DS_Store
# Windows system files
Thumbs.db
# VS Code settings (often specific to your local machine)
.vscode/
# IntelliJ/WebStorm settings
.idea/
# Vim swap files
*.swp
*.swo

# --- 6. Testing & Coverage ---
coverage/
*.lcov
.nyc_output
    